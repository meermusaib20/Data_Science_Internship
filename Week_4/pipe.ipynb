import pandas as pd
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import StandardScaler, OneHotEncoder

# ---------- Helper: detect feature types ----------
def detect_feature_types(df):
    numeric_features = df.select_dtypes(include=['int64', 'float64']).columns.tolist()
    categorical_features = df.select_dtypes(include=['object', 'category']).columns.tolist()

    binary_features = [col for col in categorical_features if df[col].nunique() == 2]
    nominal_features = [col for col in categorical_features if df[col].nunique() > 2]

    return numeric_features, binary_features, nominal_features


# ---------- Auto preprocessor builder ----------
def build_auto_preprocessor(df):
    num_features, bin_features, nom_features = detect_feature_types(df)

    preprocessor = ColumnTransformer(
        transformers=[
            ('num', StandardScaler(), num_features),
            ('bin', OneHotEncoder(drop='if_binary', handle_unknown='ignore'), bin_features),
            ('nom', OneHotEncoder(drop='first', handle_unknown='ignore'), nom_features)
        ]
    )
    return preprocessor


# ---------- Load data ----------
df = pd.read_csv("Mall_Customers_Encoded_Practice.csv")

# ---------- Build + apply pipeline ----------
auto_preprocessor = build_auto_preprocessor(df)
X_processed = auto_preprocessor.fit_transform(df)

# ---------- Convert to DataFrame ----------
feature_names = auto_preprocessor.get_feature_names_out()
processed_df = pd.DataFrame(X_processed, columns=feature_names)

# ---------- Save ----------
processed_df.to_csv("processed_data.csv", index=False)

print("✅ Preprocessing complete")
print("Original shape:", df.shape)
print("Processed shape:", processed_df.shape)
